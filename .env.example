# Copy this file to .env beside readme.md and replace the placeholders.
# Use your VaultSpeed API base URL, including its API path prefix if required.
VAULTSPEED_BASE_URL=https://app.vaultspeed.com/api

# Preferred: a tenant API user, or your own credentials if API login is supported.
VAULTSPEED_USERNAME=
VAULTSPEED_PASSWORD=

# Backup only: clear BOTH username/password settings to use a bearer token.
# Obtain it from an authenticated API request in the browser F12 Network tab.
# Set it here OR put the raw token in a file named token beside this file.
# Browser tokens expire; prefer username/password login for automation.
VAULTSPEED_ACCESS_TOKEN=
